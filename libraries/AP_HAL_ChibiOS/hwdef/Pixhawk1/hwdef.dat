# hw definition file for processing by chibios_hwdef.py
# for pixhawk1, based on fmuv3

include ../fmuv3/hwdef.dat
include ../include/minimize_common.inc

# CAN is outside this branch's Manual/Stabilize teaching scope.  Removing the
# four inherited CAN pins also makes HAL_NUM_CAN_IFACES resolve to zero, so Waf
# does not add the CAN-dependent library bundle implicitly.
undef PD0 PD1 PB6 PB12
undef CAN1 CAN1_RX CAN1_TX CAN2 CAN2_RX CAN2_TX

# The teaching branch intentionally excludes Lua bindings.  Keeping this
# board-local makes the supported Pixhawk1 build reproducible without changing
# global ChibiOS defaults used by other branches.
