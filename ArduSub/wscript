#!/usr/bin/env python3

def build(bld):
    vehicle = bld.path.name
    bld.ap_stlib(
        name=vehicle + '_libs',
        ap_vehicle=vehicle,
        # Keep this list explicit.  The learning branch supports only the
        # Manual/Stabilize Pixhawk1 firmware and must not silently regain the
        # full cross-vehicle dependency set through ap_common_vehicle_libraries().
        ap_libraries=[
            'AC_AttitudeControl',
            'AC_PID',
            'AP_AccelCal',
            'AP_AHRS',
            'AP_Arming',
            'AP_Baro',
            'AP_BattMonitor',
            'AP_BoardConfig',
            'AP_Common',
            'AP_Compass',
            'AP_CustomRotations',
            'AP_DAL',
            'AP_Declination',
            'AP_Filesystem',
            'AP_FlashStorage',
            'AP_GPS',
            'AP_HAL',
            'AP_HAL_Empty',
            'AP_IOMCU',
            'AP_InertialSensor',
            'AP_InternalError',
            'AP_JSButton',
            'AP_LeakDetector',
            'AP_Logger',
            'AP_Math',
            'AP_MultiHeap',
            'AP_Motors',
            'AP_NavEKF',
            'AP_NavEKF3',
            'AP_Notify',
            'AP_Param',
            'AP_RCMapper',
            'AP_RCProtocol',
            'AP_RAMTRON',
            'AP_RSSI',
            'AP_RTC',
            'AP_Relay',
            'AP_ROMFS',
            'AP_Scheduler',
            'AP_SerialManager',
            'AP_ServoRelayEvents',
            'AP_Stats',
            'AP_TempCalibration',
            'AP_Vehicle',
            'Filter',
            'GCS_MAVLink',
            'RC_Channel',
            'SRV_Channel',
            'StorageManager',
        ],
    )

    bld.ap_program(
        program_name='ardusub',
        program_groups=['bin', 'sub'],
        use=vehicle + '_libs',
    )
